{
  "name": "hetzner-dns-mcp",
  "version": "0.4.0",
  "mcpName": "io.github.ni-c/hetzner-dns-mcp",
  "description": "Model Context Protocol (MCP) server for managing DNS zones and records via the Hetzner Cloud API",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hetzner",
    "hetzner-cloud",
    "dns"
  ],
  "license": "MIT",
  "author": "Willi Thiel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ni-c/hetzner-dns-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ni-c/hetzner-dns-mcp/issues"
  },
  "homepage": "https://github.com/ni-c/hetzner-dns-mcp#readme",
  "funding": "https://github.com/sponsors/ni-c",
  "type": "module",
  "bin": {
    "hetzner-dns-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "test:coverage": "vitest run --coverage",
    "assets": "node scripts/gen-assets.mjs",
    "assets:check": "node scripts/gen-assets.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
