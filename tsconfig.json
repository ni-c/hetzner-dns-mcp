{
  "compilerOptions": {
    // ES2024 for `String#toWellFormed`, which every string that leaves this
    // server goes through: a slice can split a surrogate pair, and a lone
    // surrogate is legal JSON that a client encoding to UTF-8 cannot represent.
    // Raising `target` rather than setting `lib` on purpose — setting `lib`
    // drops the defaults with it, and Node 22 is the floor here anyway.
    "target": "ES2024",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
